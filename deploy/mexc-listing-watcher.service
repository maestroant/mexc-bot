[Unit]
Description=MEXC listing watcher (API probe + market recorder)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/mexc-bot
ExecStart=/home/ubuntu/mexc-bot/.venv/bin/python -u tools/listing_watcher.py --real-order --market-test --cap-test
Restart=always
RestartSec=10
# Пробы и записи — дочерние процессы в своих сессиях: при перезапуске службы они должны доработать
KillMode=process
StandardOutput=append:/home/ubuntu/mexc-bot/logs/watcher.log
StandardError=append:/home/ubuntu/mexc-bot/logs/watcher.log

[Install]
WantedBy=multi-user.target
