  </diagram>
  <diagram id="4" name="TP, PnL и выход">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3285" pageHeight="2038" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="&lt;b&gt;P1 BUY заполнился&lt;/b&gt;&lt;br/&gt;• Зафиксировать фактические fills и комиссии&lt;br/&gt;• C = стоимость BUY + fees&lt;br/&gt;• Q = реально доступное количество" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FD;strokeColor=#0C87D1;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="42" y="160" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;P2 Поставить TP&lt;/b&gt;&lt;br/&gt;• TP1: +2% на 50%; TP2: +4% на Q-остаток&lt;br/&gt;• До постановки проверить minNotional/qtyStep&lt;br/&gt;• Реальное достижение TP = SELL fill" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8EF;strokeColor=#12A360;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1125" y="160" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;P3 Каждое исполнение&lt;/b&gt;&lt;br/&gt;• Получен SELL fill → R увеличивается&lt;br/&gt;• Q уменьшается на фактическое qty&lt;br/&gt;• Повтор события по ID игнорируется" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#7552C7;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2208" y="160" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;P4 Рассчитать exitVWAP&lt;/b&gt;&lt;br/&gt;• По bids для ВСЕГО оставшегося Q&lt;br/&gt;• Если bids не хватает → DEPTH_DISAPPEARED&lt;br/&gt;• Текущие spread+depth уже учтены" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#E2A115;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2208" y="621" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;P5 Общий прогноз&lt;/b&gt;&lt;br/&gt;• FullPnL = R + Q×exitVWAP×(1-fee) − C&lt;br/&gt;• StressPNL добавляет возможный extra slip&lt;br/&gt;• При Q=0 → только фактический PnL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F7F4;strokeColor=#149B95;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1125" y="621" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;P6 Проверка TP1&lt;/b&gt;&lt;br/&gt;• TP1 полностью? частично? не исполнен?&lt;br/&gt;• Для 20 из 50 проданных R от 20, Q от 80&lt;br/&gt;• Каждый partial меняет защитный P_BE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E7;strokeColor=#E77826;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="42" y="621" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;P7 Общая защита&lt;/b&gt;&lt;br/&gt;• После положительного partial SELL активировать&lt;br/&gt;• Цель всей сделки 0% или +0.5% (тест)&lt;br/&gt;• StressFullPnL ≤ цель → срочный выход" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#E2A115;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="42" y="1082" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;P8 Уровень P_BE&lt;/b&gt;&lt;br/&gt;• P_BE=(C−R)/(Q×(1−sellFee))&lt;br/&gt;• P_LOCK: вместо C берём C×(1+цель)&lt;br/&gt;• requiredVWAP=P_LOCK/(1−stress)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#7552C7;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1125" y="1082" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;P9 Приоритет риска&lt;/b&gt;&lt;br/&gt;• HARD_STOP, dump, no depth → немедленный EXIT&lt;br/&gt;• Time stop или BE/TotalPnL guard → EXIT&lt;br/&gt;• Нельзя гарантировать продажу в плюс" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EF;strokeColor=#D85257;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2208" y="1082" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;P10 Cancel + reconcile&lt;/b&gt;&lt;br/&gt;• Запретить конкурирующие ордера&lt;br/&gt;• Отменить TP1/TP2 и учесть новые fills&lt;br/&gt;• Новый Q = BUY − все фактические SELL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FD;strokeColor=#0C87D1;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2208" y="1543" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;P11 Продать остаток&lt;/b&gt;&lt;br/&gt;• Aggressive LIMIT SELL; ждать до 400 мс&lt;br/&gt;• До 3 перестановок с cancel+verify&lt;br/&gt;• Не получилось → проектный fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EF;strokeColor=#D85257;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1125" y="1543" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;P12 Финальная сверка&lt;/b&gt;&lt;br/&gt;• Q=0 + все ордера известны → CLOSED&lt;br/&gt;• Есть dust/UNKNOWN → RESIDUAL_OPEN&lt;br/&gt;• PnL, исполнения и слippage в журнал" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8EF;strokeColor=#12A360;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="42" y="1543" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="7" target="8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="8" target="9">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="9" target="10">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="10" target="11">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="11" target="12">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="12" target="13">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
