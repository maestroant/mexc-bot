  </diagram>
  <diagram id="2" name="FAST">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3285" pageHeight="2038" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="&lt;b&gt;A1 Снятие подтверждено&lt;/b&gt;&lt;br/&gt;• Получить CAP_RELEASED и releaseEventId&lt;br/&gt;• Открыть FAST окно: 10 секунд&lt;br/&gt;• Есть другая позиция/ордер? → SKIP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FD;strokeColor=#0C87D1;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="42" y="160" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;A2 Свежий стакан&lt;/b&gt;&lt;br/&gt;• Получить bestBid, bestAsk, diff-depth&lt;br/&gt;• Возраст ≤250 мс, нет потерь sequence&lt;br/&gt;• Нет → восстановить и дождаться обновления" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#E2A115;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1125" y="160" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;A3 Проверка ликвидности&lt;/b&gt;&lt;br/&gt;• Spread ≤1.2%; нужный объём asks&lt;br/&gt;• Bid07 ≥15×; Bid15 ≥30×; Ask07 ≥8×&lt;br/&gt;• Нет → ждать до FAST deadline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8EF;strokeColor=#12A360;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2208" y="160" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;A4 Проверка выхода&lt;/b&gt;&lt;br/&gt;• Рассчитать exitVWAP на ВСЮ qty&lt;br/&gt;• Slippage depth ≤1.5% + отдельный stress&lt;br/&gt;• Если нет покупателей → BUY запрещён" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#7552C7;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2208" y="621" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;A5 Цена не убежала&lt;/b&gt;&lt;br/&gt;• Рассчитать buyVWAP и контроль chase&lt;br/&gt;• Price cap от bestAsk +1%&lt;br/&gt;• Нет → не повышать LIMIT вслед за рынком" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E7;strokeColor=#E77826;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1125" y="621" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;A6 Повторная проверка&lt;/b&gt;&lt;br/&gt;• Актуальные bid/ask и ордера перед отправкой&lt;br/&gt;• minQty/minNotional и остаточный риск&lt;br/&gt;• Нет → следующий снимок до дедлайна" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FD;strokeColor=#0C87D1;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="42" y="621" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;A7 Отправить BUY&lt;/b&gt;&lt;br/&gt;• Один LIMIT BUY и уникальный clientOrderId&lt;br/&gt;• Не делать вторую попытку на этом событии&lt;br/&gt;• Timeout создания → ORDER_UNKNOWN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8EF;strokeColor=#12A360;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="42" y="1082" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;A8 Исполнение BUY&lt;/b&gt;&lt;br/&gt;• Ждать до 1200 мс или полный fill&lt;br/&gt;• Partial → отменить неполученный остаток&lt;br/&gt;• Нет fill → SKIP; UNKNOWN → RECONCILE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#7552C7;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1125" y="1082" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;A9 Фактическая позиция&lt;/b&gt;&lt;br/&gt;• Исполненная qty, фактическая средняя BUY&lt;br/&gt;• Комиссии, minNotional для TP1 и TP2&lt;br/&gt;• DUST/недопустимые лоты → отдельный риск" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#E2A115;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2208" y="1082" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;A10 Старт TP и PnL&lt;/b&gt;&lt;br/&gt;• Поставить допустимые TP1/TP2&lt;br/&gt;• Считать C, R, Q, exitVWAP и stress&lt;br/&gt;• Любой fill SELL запускает пересчёт" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F7F4;strokeColor=#149B95;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2208" y="1543" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;A11 Защита / выход&lt;/b&gt;&lt;br/&gt;• TP1 partial → пересчитать P_BE/P_LOCK&lt;br/&gt;• При угрозе общего PnL → cancel TP&lt;br/&gt;• Aggressive LIMIT SELL → fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EF;strokeColor=#D85257;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1125" y="1543" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;A12 Финал FAST&lt;/b&gt;&lt;br/&gt;• Только после Q=0 и сверки ордеров&lt;br/&gt;• Сохранить actual slippage, PnL, причины&lt;br/&gt;• Иначе RESIDUAL_OPEN / MANUAL_REVIEW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FD;strokeColor=#0C87D1;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="42" y="1543" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="7" target="8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="8" target="9">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="9" target="10">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="10" target="11">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="11" target="12">
          <mxGeometry relative="1" as="geometry"/>
