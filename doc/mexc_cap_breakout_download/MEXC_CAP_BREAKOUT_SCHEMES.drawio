  <diagram id="3" name="CONFIRMED">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3285" pageHeight="2038" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="&lt;b&gt;B1 CAP_RELEASED&lt;/b&gt;&lt;br/&gt;• Открыть CONFIRMED окно на 30 секунд&lt;br/&gt;• Создать счётчики stableSince и updates&lt;br/&gt;• Конфликт позиции → SKIP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FD;strokeColor=#0C87D1;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="42" y="160" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;B2 Новая рыночная порция&lt;/b&gt;&lt;br/&gt;• Принимать только реальные новые WS события&lt;br/&gt;• Проверять sequence и возраст ≤500 мс&lt;br/&gt;• Gap → восстановить стакан; reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#E2A115;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1125" y="160" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;B3 Все фильтры сразу&lt;/b&gt;&lt;br/&gt;• Spread ≤1.2%; bid07 ≥15×, bid15 ≥30×&lt;br/&gt;• Ask07 ≥8×; exit slip ≤1.5%&lt;br/&gt;• Любой fail → обнулить stableSince" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8EF;strokeColor=#12A360;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2208" y="160" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;B4 Проверить устойчивость&lt;/b&gt;&lt;br/&gt;• Непрерывное выполнение ≥200 мс&lt;br/&gt;• ≥3 разных bookVersion/WS обновления&lt;br/&gt;• Таймеры пересчёта НЕ считаются событиями" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#7552C7;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2208" y="621" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;B5 Сценарный риск&lt;/b&gt;&lt;br/&gt;• BuyVWAP, exitVWAP и будущий stress&lt;br/&gt;• Проверить цену, разворот, резерв риска&lt;br/&gt;• Нет → сбросить streak/ждать" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E7;strokeColor=#E77826;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1125" y="621" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;B6 Pre-send проверка&lt;/b&gt;&lt;br/&gt;• Перед LIMIT BUY обновить bid/ask/qty&lt;br/&gt;• Не догонять цену и не превышать cap BUY&lt;br/&gt;• Если плохой рынок → возврат к B2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FD;strokeColor=#0C87D1;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="42" y="621" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;B7 Единственный BUY&lt;/b&gt;&lt;br/&gt;• LIMIT по bestAsk +1%; qty по USDT&lt;br/&gt;• Уникальный clientOrderId&lt;br/&gt;• Неотвеченный API → RECONCILE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8EF;strokeColor=#12A360;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="42" y="1082" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;B8 Контроль fills&lt;/b&gt;&lt;br/&gt;• До 1200 мс; cancel оставшуюся заявку&lt;br/&gt;• Partial → только фактический объём&lt;br/&gt;• Zero fill → SKIP, без повторного BUY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#7552C7;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1125" y="1082" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;B9 Управление остатком&lt;/b&gt;&lt;br/&gt;• TP1/TP2 после minNotional проверки&lt;br/&gt;• Оценка полного PnL после каждого fill&lt;br/&gt;• Не считать касание тейка исполнением" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#E2A115;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2208" y="1082" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;B10 Общая защита&lt;/b&gt;&lt;br/&gt;• C/R/Q, стрессовый exitVWAP и P_BE&lt;br/&gt;• TP1 исполнен частично → защита слабее&lt;br/&gt;• Если целевая прибыль под угрозой → EXIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F7F4;strokeColor=#149B95;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2208" y="1543" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;B11 Urgent SELL&lt;/b&gt;&lt;br/&gt;• Cancel TP и сверка fills, затем новый Q&lt;br/&gt;• LIMIT SELL / bounded cancel-reprice&lt;br/&gt;• UNKNOWN никогда не дублировать" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EF;strokeColor=#D85257;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1125" y="1543" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;B12 Финал CONFIRMED&lt;/b&gt;&lt;br/&gt;• Deadline без стабильности → SKIP&lt;br/&gt;• После входа закрытие только Q=0&lt;br/&gt;• Сохранить исполнение, риски, slippage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FD;strokeColor=#0C87D1;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="42" y="1543" width="1035" height="395" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="7" target="8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="8" target="9">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="9" target="10">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="10" target="11">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="11" target="12">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="12" target="13">
          <mxGeometry relative="1" as="geometry"/>
