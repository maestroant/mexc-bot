<?xml version="1.0" ?>
<mxfile host="app.diagrams.net" modified="2026-10-27T18:00:00Z" agent="ChatGPT" version="24.7.17" type="device">
  <diagram id="1" name="Общая карта">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3628" pageHeight="1852" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="&lt;b&gt;1 Новый листинг&lt;/b&gt;&lt;br/&gt;• Получить symbol, время, tick/qty step и комиссии&lt;br/&gt;• Подключить WS: deals, bookTicker, diff-depth&lt;br/&gt;• Собрать локальный стакан; открыть ledger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FD;strokeColor=#0C87D1;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="42" y="160" width="850" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;2 Определить потолок&lt;/b&gt;&lt;br/&gt;• Подтвердить capPrice: источник + время&lt;br/&gt;• Ошибка 30010 может содержать верхнюю границу&lt;br/&gt;• order/test и плоская цена НЕ доказывают cap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8EF;strokeColor=#12A360;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="940" y="160" width="850" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;3 Ожидать разблокировку&lt;/b&gt;&lt;br/&gt;• Мониторить сделки и bid/ask непрерывно&lt;br/&gt;• T+600 — лишь ориентир для известных 10 минут&lt;br/&gt;• При потере depth sequence — BOOK_RECOVERY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#E2A115;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1838" y="160" width="850" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;4 Подтвердить снятие&lt;/b&gt;&lt;br/&gt;• Реальная сделка строго выше capPrice&lt;br/&gt;• BestBid тоже выше capPrice + шаг цены&lt;br/&gt;• Стакан свежий и синхронизированный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#7552C7;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2736" y="160" width="850" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;5 Выбрать алгоритм&lt;/b&gt;&lt;br/&gt;• В LIVE активен только FAST ИЛИ CONFIRMED&lt;br/&gt;• Проверить позиции и неизвестные ордера&lt;br/&gt;• В REPLAY обе стратегии независимы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F7F4;strokeColor=#149B95;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2736" y="716" width="850" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;6A FAST BREAKOUT&lt;/b&gt;&lt;br/&gt;• Сканировать подходящий стакан максимум 10 с&lt;br/&gt;• Без 200 мс стабилизации, но с depth/VWAP&lt;br/&gt;• Проверить spread, stress-loss, chase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2E7;strokeColor=#E77826;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1838" y="716" width="850" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;6B CONFIRMED BREAKOUT&lt;/b&gt;&lt;br/&gt;• Сканировать не дольше 30 с&lt;br/&gt;• Все фильтры стабильны ≥200 мс&lt;br/&gt;• Требовать ≥3 независимых обновления" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FD;strokeColor=#0C87D1;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="940" y="716" width="850" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;7 LIMIT BUY&lt;/b&gt;&lt;br/&gt;• price ≤ bestAsk × 1.01; qty по orderUSDT&lt;br/&gt;• Покупка одна: timeout 1200 мс&lt;br/&gt;• Cancel/reconcile остатка; partial → ledger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8EF;strokeColor=#12A360;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="42" y="716" width="850" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="&lt;b&gt;8 TP1 / TP2 и fills&lt;/b&gt;&lt;br/&gt;• TP1 +2% на 50%; TP2 +4% на остаток&lt;br/&gt;• Важны fills, не касания цен; minNotional&lt;br/&gt;• После любого SELL → обновить R, Q, fees" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#7552C7;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="42" y="1272" width="850" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="&lt;b&gt;9 Защита общего PnL&lt;/b&gt;&lt;br/&gt;• C = все BUY + fee; R = SELL после fee&lt;br/&gt;• Остаток оценивается по exitVWAP и stress&lt;br/&gt;• После частичного TP — BE/LOCK по всей сделке" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#E2A115;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="940" y="1272" width="850" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;10 Срочная продажа&lt;/b&gt;&lt;br/&gt;• Cancel TP → сверить fills → вычислить Q&lt;br/&gt;• Aggressive LIMIT SELL, до 3 перестановок&lt;br/&gt;• Критический fallback; никаких слепых дублей" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EF;strokeColor=#D85257;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1838" y="1272" width="850" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;11 Завершение&lt;/b&gt;&lt;br/&gt;• Q=0 и все SELL имеют известный статус&lt;br/&gt;• PnL только по реальным сделкам и fee&lt;br/&gt;• Сохранить причины, slippage и полный REPLAY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6FD;strokeColor=#0C87D1;fontSize=20;spacing=20;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="2736" y="1272" width="850" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#4F778F;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry"/>
